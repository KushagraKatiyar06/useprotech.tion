# Environment — never commit secrets
.env
testing/.env
agents/.env
*.env
# but DO commit example/template files:
!*.env.example
!.env.local.example

# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Sandbox generated patches (can be large, machine-specific)
testing/patches/

# Malware samples (new samples stay local-only; the demo sample below ships with the app)
*.malicious
*.mal
*.bin
*.exe
*.dll
*.ps1
testing/samples/*
!testing/samples/6108674530.JS.malicious

# Analysis output (same deal — the demo result below ships with the app)
*.json
output/
testing/results/*
!testing/results/sample_malware_behavior.json

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
